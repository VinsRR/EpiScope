# EpiLens Docker Compose configuration
#
# Copy this file before starting the Compose stack:
#
#     cp .env.docker.example .env
#
# Add one provider credential if you want generated answers. Parsing, indexing,
# and retrieval can run without a hosted LLM key.

# --- LLM provider ------------------------------------------------------------
EPILENS_LLM_PROVIDER=gemini
EPILENS_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# A separately running Ollama service can also be used for local generation.
OLLAMA_HOST=http://host.docker.internal:11434

# --- Embeddings and parsing --------------------------------------------------
EPILENS_EMBED_PROVIDER=auto
EPILENS_DEVICE=cpu
EPILENS_STRATEGY_NAME=grobid
GROBID_URL=http://localhost:8070

# --- Corpus backends ---------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=epilens_academic
QDRANT_VERSION=1.13.5
MONGO_URI=
MONGO_DB_NAME=epilens_academic_db

# --- Host bindings -----------------------------------------------------------
# These loopback defaults keep the services private to this machine.
EPILENS_API_BIND_ADDRESS=127.0.0.1
EPILENS_UI_BIND_ADDRESS=127.0.0.1
EPILENS_PROXY_BIND_ADDRESS=127.0.0.1
EPILENS_PROXY_PORT=8080

# The API process listens inside its container; Compose keeps the host binding
# on 127.0.0.1 unless you deliberately change the values above.
EPILENS_API_HOST=0.0.0.0
EPILENS_API_PORT=8000
EPILENS_API_BASE_URL=http://localhost:8000

# --- Optional behavior -------------------------------------------------------
CROSS_ENCODER_MODEL=
EPILENS_LOG_LEVEL=INFO
EPILENS_OUTPUT_FORMAT=human
EPILENS_TASKS_DIR=
