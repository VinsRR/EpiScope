# EpiLens environment configuration
#
# Copy this file to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is loaded automatically (see src/epilens/settings.py) and is gitignored.
# Inspecting and retrieving need no LLM. For generated answers, install the
# matching extra (for example `epilens[gemini]`) and set its key, or use a local
# Ollama server. MongoDB and Qdrant are only needed for external-store paths.

# --- LLM provider -----------------------------------------------------------
# Provider used for answer generation and classification.
# One of: gemini | openai | openrouter | anthropic | ollama
EPILENS_LLM_PROVIDER=gemini
EPILENS_LLM_MODEL=gemini-2.5-flash

# Embedding provider: auto (default; inferred from the model name) | huggingface
# | openai | gemini | ollama.
EPILENS_EMBED_PROVIDER=auto

# Torch compute device: auto (default) | cpu | cuda | mps.
# "auto" uses the GPU only if your torch build supports it, else CPU — set "cpu"
# to be safe on older/unsupported GPUs.
EPILENS_DEVICE=auto

# Provider credentials (install and set only the one you use).
# Extras: `epilens[gemini]`, `epilens[openai]`, `epilens[openrouter]`, or
# `epilens[anthropic]`.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: custom OpenAI-compatible endpoint (e.g. Azure, a local gateway).
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama server (used when EPILENS_LLM_PROVIDER=ollama).
OLLAMA_HOST=http://localhost:11434

# Optional cross-encoder model for evidence reranking (HuggingFace name).
CROSS_ENCODER_MODEL=

# --- Corpus backends (API / UI only; not needed for the local CLI) ----------
# MongoDB stores parsed paper metadata, sections, and references.
MONGO_URI=
MONGO_DB_NAME=epilens_academic_db

# Qdrant vector store used for retrieval.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=epilens_academic
# Qdrant server image tag for Docker Compose. Keep this minor (1.13.*) in
# lockstep with the qdrant-client pin in pyproject.toml — the client and server
# must share the same minor version, and QdrantDB hard-errors otherwise.
QDRANT_VERSION=1.13.5

# GROBID service for PDF parsing (used when EPILENS_STRATEGY_NAME=grobid).
GROBID_URL=http://localhost:8070
EPILENS_STRATEGY_NAME=grobid

# --- API server -------------------------------------------------------------
EPILENS_API_HOST=0.0.0.0
EPILENS_API_PORT=8000
EPILENS_API_BASE_URL=http://localhost:8000

# --- Logging ----------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR
EPILENS_LOG_LEVEL=INFO

# --- CLI --------------------------------------------------------------------
# Default output format for the `epilens` CLI: human (default) or json.
# Per-command --format always overrides this.
EPILENS_OUTPUT_FORMAT=human

# Directory of JSON task specs to auto-load at startup (declarative classifiers
# and miners). Both the CLI and the API server read this.
EPILENS_TASKS_DIR=
