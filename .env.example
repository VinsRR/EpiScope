# EpiScope environment configuration
#
# Copy this file to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is loaded automatically (see src/episcope/settings.py) and is gitignored.
# For the local-first CLI path you only need an LLM API key (or a local Ollama
# server). MongoDB and Qdrant are only required for the API/UI corpus backends.

# --- LLM provider -----------------------------------------------------------
# Provider used for answer generation and classification.
# One of: gemini | openai | openrouter | anthropic | ollama
EPISCOPE_LLM_PROVIDER=gemini
EPISCOPE_LLM_MODEL=gemini-2.5-flash

# Embedding provider: auto (default; inferred from the model name) | huggingface
# | openai | gemini | ollama.
EPISCOPE_EMBED_PROVIDER=auto

# Torch compute device: auto (default) | cpu | cuda | mps.
# "auto" uses the GPU only if your torch build supports it, else CPU — set "cpu"
# to be safe on older/unsupported GPUs.
EPISCOPE_DEVICE=auto

# Provider credentials (set the one matching EPISCOPE_LLM_PROVIDER).
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: custom OpenAI-compatible endpoint (e.g. Azure, a local gateway).
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama server (used when EPISCOPE_LLM_PROVIDER=ollama).
OLLAMA_HOST=http://localhost:11434

# Optional cross-encoder model for evidence reranking (HuggingFace name).
CROSS_ENCODER_MODEL=

# --- Corpus backends (API / UI only; not needed for the local CLI) ----------
# MongoDB stores parsed paper metadata, sections, and references.
MONGO_URI=
MONGO_DB_NAME=episcope_academic_db

# Qdrant vector store used for retrieval.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=episcope_academic

# GROBID service for PDF parsing (used when EPISCOPE_STRATEGY_NAME=grobid).
GROBID_URL=http://localhost:8070
EPISCOPE_STRATEGY_NAME=grobid

# --- API server -------------------------------------------------------------
EPISCOPE_API_HOST=0.0.0.0
EPISCOPE_API_PORT=8000
EPISCOPE_API_BASE_URL=http://localhost:8000

# --- Logging ----------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR
EPISCOPE_LOG_LEVEL=INFO

# --- CLI --------------------------------------------------------------------
# Default output format for the `episcope` CLI: human (default) or json.
# Per-command --format always overrides this.
EPISCOPE_OUTPUT_FORMAT=human

# Directory of JSON task specs to auto-load at startup (declarative classifiers
# and miners). Both the CLI and the API server read this.
EPISCOPE_TASKS_DIR=
