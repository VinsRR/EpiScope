[Unit]
Description=EpiScope Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/episcope
ExecStart=/usr/bin/docker compose --profile deploy up -d
ExecStop=/usr/bin/docker compose --profile deploy down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
